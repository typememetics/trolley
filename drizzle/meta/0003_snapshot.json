      "checkConstraints": {
        "round_distinct_players": {
          "name": "round_distinct_players",
          "value": "\"round\".\"player_user_id\" <> \"round\".\"opponent_user_id\""
        },
        "round_player_argument_not_blank": {
          "name": "round_player_argument_not_blank",
          "value": "trim(\"round\".\"player_argument_snapshot\") <> ''"
        },
        "round_opponent_defense_not_blank": {
          "name": "round_opponent_defense_not_blank",
          "value": "trim(\"round\".\"opponent_defense_snapshot\") <> ''"
        },
        "round_status_valid": {
          "name": "round_status_valid",
          "value": "\"round\".\"status\" in ('created', 'judging', 'resolved', 'failed')"
        },
        "round_decision_valid": {
          "name": "round_decision_valid",
          "value": "\"round\".\"decision\" is null or \"round\".\"decision\" in ('flip', 'dont_flip')"
        },
        "round_failure_code_valid": {
          "name": "round_failure_code_valid",
          "value": "\"round\".\"failure_code\" is null or \"round\".\"failure_code\" in ('jev_failed', 'invalid_jev_result', 'judging_timeout')"
        },
        "round_probability_flip_range": {
          "name": "round_probability_flip_range",
          "value": "\"round\".\"probability_flip\" is null or (\"round\".\"probability_flip\" >= 0 and \"round\".\"probability_flip\" <= 1)"
        },
        "round_probability_dont_flip_range": {
          "name": "round_probability_dont_flip_range",
          "value": "\"round\".\"probability_dont_flip\" is null or (\"round\".\"probability_dont_flip\" >= 0 and \"round\".\"probability_dont_flip\" <= 1)"
        },
        "round_confidence_range": {
          "name": "round_confidence_range",
          "value": "\"round\".\"confidence\" is null or (\"round\".\"confidence\" >= 0 and \"round\".\"confidence\" <= 1)"
        },
        "round_model_not_blank": {
          "name": "round_model_not_blank",
          "value": "\"round\".\"model\" is null or trim(\"round\".\"model\") <> ''"
        },
        "round_judging_at_matches_status": {
          "name": "round_judging_at_matches_status",
          "value": "(\"round\".\"judging_at\" is null) = (\"round\".\"status\" = 'created')"
        },
        "round_result_matches_status": {
          "name": "round_result_matches_status",
          "value": "\n    (\"round\".\"status\" = 'resolved') = (\n      \"round\".\"decision\" is not null and \"round\".\"probability_flip\" is not null and \"round\".\"probability_dont_flip\" is not null\n      and \"round\".\"confidence\" is not null and \"round\".\"model\" is not null and \"round\".\"resolved_at\" is not null\n    )\n    and (\"round\".\"status\" = 'resolved' or (\n      \"round\".\"decision\" is null and \"round\".\"probability_flip\" is null and \"round\".\"probability_dont_flip\" is null\n      and \"round\".\"confidence\" is null and \"round\".\"model\" is null and \"round\".\"resolved_at\" is null\n    ))"
        },
        "round_failure_matches_status": {
          "name": "round_failure_matches_status",
          "value": "\n    (\"round\".\"status\" = 'failed') = (\"round\".\"failure_code\" is not null and \"round\".\"failed_at\" is not null)\n    and (\"round\".\"status\" = 'failed' or (\"round\".\"failure_code\" is null and \"round\".\"failed_at\" is null))"
        }
      }
    }
