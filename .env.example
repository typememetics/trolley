# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth app. Callback: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Turso database: `turso db show --url <db>` and `turso db tokens create <db>`.
# A local file works for offline development: TURSO_DATABASE_URL=file:local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# TypeSafe API key for JEV, the referee. Server-only: never prefix it with NEXT_PUBLIC_.
TYPESAFE_API_KEY=

# Vercel sends this as Authorization: Bearer <secret> for scheduled checkpoint checks.
# Generate with: openssl rand -hex 32. Server-only; set in Vercel production too.
CRON_SECRET=
